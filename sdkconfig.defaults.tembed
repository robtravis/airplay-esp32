# LilyGO T-Embed ESP32-S3 — Rob's board
#
# Overrides on top of sdkconfig.defaults + sdkconfig.defaults.esp32s3.
# Pin numbers taken from the radio firmware's config.h, which is known-good
# against this hardware:
#   PCM5102A: BCK->38, LCK/WS->40, DIN->41, FMT->GND, XSMT->3V3
CONFIG_I2S_BCK_IO=38
CONFIG_I2S_WS_IO=40
CONFIG_I2S_DO_IO=41

# PCM5102A generates its own clock from an internal PLL, so no MCLK is needed.
# The devkit default was GPIO 8 — leave it undriven rather than assert a signal
# onto a pin whose use on this board is owned by the display setup.
CONFIG_I2S_SCK_IO=-1

# This is a GPIO *driven low* as a ground reference (20mA max) for boards that
# need it. This one has a real ground wire to the DAC, so disable it. The devkit
# default was GPIO 14.
CONFIG_I2S_GND_IO=-1

# Route the console to the built-in USB Serial/JTAG peripheral. IDF defaults the
# console to UART0 (GPIO 43/44), which is NOT wired to USB on this board — the
# port enumerates from ROM so the device looks alive while printing nothing.
# Same trap as needing CDCOnBoot=cdc on the Arduino side.
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# ── Display: ST7789 320x170 ─────────────────────────────────────────────────────
# Pins taken from TFT_eSPI's Setup210_LilyGo_T_Embed_S3.h, which the radio
# firmware uses and is therefore known-good against this panel.
#
# The Kconfig defaults already describe this exact panel (320x170, X gap 0,
# Y gap 35) — the 35-row Y offset is what stops the image sitting off-screen on a
# 170-tall ST7789.
CONFIG_DISPLAY_ENABLED=y
CONFIG_DISPLAY_DRIVER_ST7789=y
CONFIG_DISPLAY_SPI_CLK=12
CONFIG_DISPLAY_SPI_MOSI=11
CONFIG_DISPLAY_SPI_CS=10
CONFIG_DISPLAY_SPI_DC=13
CONFIG_DISPLAY_SPI_RST=9
CONFIG_DISPLAY_BL_GPIO=15
CONFIG_DISPLAY_ST7789_WIDTH=320
CONFIG_DISPLAY_ST7789_HEIGHT=170
CONFIG_DISPLAY_ST7789_GAP_X=0
CONFIG_DISPLAY_ST7789_GAP_Y=35
CONFIG_DISPLAY_UPDATE_MS=500

# Rotate 180° — the T-Embed's panel orientation puts the image upside down
# relative to how the unit sits. Applied at the panel level (mirror/swap), so the
# SPIFFS background image rotates with it rather than needing to be pre-flipped.
CONFIG_DISPLAY_FLIP=y

# ── Cover art ──────────────────────────────────────────────────────────────────
# Off by default upstream, and the README is explicit that it is disabled "to
# prevent audio pipeline stalls" — the same failure class that caused the radio's
# dropouts on 2026-08-09, where a 43KB sprite push at 25Hz starved the audio pump.
# Artwork is far larger than a sprite, so watch for it.
#
# HOW TO TELL: the audio_time "Playout:" lines report `gaps=` and `outliers=`.
# Baseline with the display on and artwork off was gaps=0 and a static outlier
# count. If gaps starts climbing after enabling this, artwork is the cause —
# revert to n rather than trying to tune around it.
# Turned back OFF: the ST7789 renderer has no artwork widget. ui_create() builds
# labels, a progress bar and the background image — nothing that draws cover art.
# So this option enables *reception* only, and nothing renders it. Displaying it
# would need a JPEG decoder plus an LVGL image object, i.e. real work upstream.
# Leaving it on costs the audio-stall risk the README warns about for no benefit.
CONFIG_ENABLE_AIRPLAY_ARTWORK=n

# display_st7789.c references montserrat 14/16/24, but LVGL only enables 14 by
# default — without these the build fails with 'lv_font_montserrat_24 undeclared'.
# Upstream CI builds esp32s3 with the display OFF, so this path does not compile
# as shipped.
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_24=y

# GPIO 46 gates the peripheral power rail on this board — the panel stays dark
# without it. See BOARD_POWER_ON_GPIO in components/boards/Kconfig.projbuild.
CONFIG_BOARD_POWER_ON_GPIO=46

# Note: the display SPI pins (MOSI 11, SCLK 12, DC 13) collide with the stock
# esp32s3 I2S defaults (BCK 11, WS 13, DO 12). Our I2S override to 38/40/41 above
# is what makes both work together — do not revert it.

# Superseded: display was disabled for the first flash: prove audio in isolation. The T-Embed's
# ST7789 is supported (CONFIG_DISPLAY_DRIVER_ST7789) but needs its own pin set
# plus PIN_POWER_ON (GPIO 46) held high to power the panel rail, which is a
# separate piece of work.

# ── Internet radio source ──────────────────────────────────────────────────────
# Plays the Vibe Radio stream when no AirPlay session is active. MP3 decoding
# comes from espressif/esp_audio_codec, which the project already depends on for
# AAC/ALAC — no new dependency.
CONFIG_RADIO_ENABLED=y
CONFIG_RADIO_STREAM_URL="http://viberadio.one/mobile.mp3"
CONFIG_RADIO_RING_BYTES=131072
CONFIG_RADIO_PREFILL_BYTES=98304
CONFIG_RADIO_STALL_MS=1500
CONFIG_RADIO_NOWPLAYING_URL="http://viberadio.one/api/nowplaying/vibe_radio"
CONFIG_RADIO_NOWPLAYING_MS=15000
CONFIG_RADIO_STATION_NAME="VIBE RADIO"

# Type scale for the now-playing screen: 28pt title / 18pt artist / 14pt rest.
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_28=y

# ── Physical controls ──────────────────────────────────────────────────────────
# Rotary encoder: rotation = volume. Pins from the radio firmware's config.h.
CONFIG_ENCODER_A_GPIO=2
CONFIG_ENCODER_B_GPIO=1
# The encoder's push-switch is GPIO 0, which is also the BOOT button. It is owned
# by encoder.c rather than buttons.c, because the menu needs short vs long press
# on the same pin and two owners would fight over it. BTN_PLAY_PAUSE stays -1.
CONFIG_ENCODER_BTN_GPIO=0

# Branding: AirPlay/mDNS speaker name comes from SETTINGS_DEFAULT_DEVICE_NAME
# ("Vibe Radio"). The setup AP gets "Setup" appended so it is distinguishable
# from the speaker itself in a WiFi list.
CONFIG_DEFAULT_AP_SSID="Vibe Radio Setup"

# ── APA102 LED ring ────────────────────────────────────────────────────────────
# 7 LEDs built into the T-Embed. Pins and brightness from the radio's config.h.
CONFIG_LED_RING_ENABLE=y
CONFIG_LED_RING_DATA_GPIO=42
CONFIG_LED_RING_CLK_GPIO=45
CONFIG_LED_RING_COUNT=7
CONFIG_LED_RING_SCALE=96
CONFIG_ARCHIVE_URL="http://viberadio.one/api/public/recordings"
CONFIG_ARCHIVE_BASE="http://viberadio.one"
